# Runtime database connection. For Supabase, prefer the Supavisor Session pooler
# string on port 5432 for local/dev or a transaction pooler string with
# pgbouncer enabled for serverless deployments.
DATABASE_URL="postgresql://USER.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres"

# Optional Prisma CLI connection. If omitted, Prisma CLI uses DATABASE_URL.
DIRECT_URL="postgresql://USER.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres"

ADMIN_EMAIL="admin@detailinghub.rs"
ADMIN_PASSWORD="change-me"
AUTH_SECRET="generate-a-long-random-secret"
ANALYTICS_SALT="generate-another-long-random-secret"
DATABASE_POOL_MAX="3"
NEXT_PUBLIC_SITE_URL="https://detailinghub.rs"

# Supabase Storage. Service role key is server-only; never expose it in client code.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="studio-images"
